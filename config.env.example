# Copy this file to `config.env` and adjust if your dataset lives elsewhere.
# The path is interpreted relative to the project root.
#
# Default layout assumes you've extracted Sleep-EDF Expanded under data/:
#
#     data/sleep-edfx/sleep-edf-database-expanded-1.0.0/
#         sleep-cassette/
#         sleep-telemetry/

SLEEP_EDF_ROOT=data/sleep-edfx/sleep-edf-database-expanded-1.0.0
